# Application runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4500
FRONTEND_URL=http://localhost:3200
CORS_ORIGINS=http://localhost:3200
LOG_LEVEL=log

# Database and connection safeguards
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
DATABASE_SCHEMA=YOUR_POSTGRES_SCHEMA
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA=certs/global-bundle.pem
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=1800
DATABASE_CONNECT_RETRIES=3
DATABASE_CONNECT_RETRY_DELAY_MS=1000
DATABASE_HEALTH_TIMEOUT_MS=3000

# Authentication and sessions
AUTH_JWT_PRIVATE_KEY_PATH=certs/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=certs/jwt-public.pem
AUTH_HASH_SECRET_PATH=certs/auth-hash-secret
AUTH_ACTION_TOKEN_SECRET_PATH=certs/auth-action-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200
AUTH_SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=300
AUTH_INVITATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_ACTION_RESEND_COOLDOWN_SECONDS=60
AUTH_REFRESH_COOKIE_NAME=dsp_refresh
AUTH_ISSUER=group-erp
AUTH_AUDIENCE=group-erp-web
SAAS_SELF_REGISTRATION_ENABLED=false

# SMTP email
EMAIL_ENABLED=false
EMAIL_DEV_BYPASS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Group ERP
SMTP_REPLY_TO=
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_SEND_TIMEOUT_MS=30000
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Redis session/auth cache. PostgreSQL remains the durable source and fallback.
# Required for production and E2E (sessions, rate limits, download tokens).
# Local Docker: from the repository root run `docker compose up -d redis`
# (pinned to redis:7.2.16-alpine), then use HOST=localhost PORT=6379.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=dsp-pms:
REDIS_CACHE_TTL=60
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

# Public careers and recruitment
PUBLIC_CAREERS_ENABLED=true
RECRUITMENT_UPLOAD_DIR=uploads/recruitment
RECRUITMENT_DOWNLOAD_TTL_SECONDS=300
TURNSTILE_SECRET_KEY=
PUBLIC_CAREERS_RATE_LIMIT_PER_HOUR=10

# Object storage and malware scanning
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PREFIX=
STORAGE_PRESIGNED_PUT_TTL_SECONDS=900
STORAGE_PRESIGNED_GET_TTL_SECONDS=300
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_MAX_STREAM_BYTES=26214400
FILE_SCAN_WORKER_ENABLED=false
SIGNED_OFFER_VERIFICATION_ENABLED=false
FILE_RETENTION_PURGE_ENABLED=false
FILE_NAME_ENC_ACTIVE_KEY_VERSION=v1
FILE_NAME_ENC_ACCEPTED_KEY_VERSIONS=v1
FILE_NAME_ENC_KEYS_JSON=

# Background workers and schedules
WORKFORCE_JOBS_ENABLED=false
WORKFORCE_JOB_BATCH_SIZE=100
ATTENDANCE_FINALIZER_INTERVAL_MINUTES=15
WORKFORCE_OUTBOX_LOCK_TIMEOUT_SECONDS=300

# Delivery security and workers
DELIVERY_CONTENT_ENCRYPTION_ACTIVE_VERSION=v1
DELIVERY_CONTENT_ENCRYPTION_KEYS_JSON=
DELIVERY_ADDRESS_HMAC_ACTIVE_VERSION=v1
DELIVERY_ADDRESS_HMAC_KEYS_JSON=
DELIVERY_COMMAND_RECEIPT_HMAC_ACTIVE_VERSION=v1
DELIVERY_COMMAND_RECEIPT_HMAC_KEYS_JSON=
DELIVERY_WORKER_LEASE_SECONDS=300
DELIVERY_WORKER_BATCH_SIZE=50

# Projects
PROJECTS_REMINDERS_ENABLED=false
PROJECTS_IDEMPOTENCY_HMAC_ACTIVE_VERSION=v1
PROJECTS_IDEMPOTENCY_HMAC_KEYS_JSON=

# Onboarding
ONBOARDING_REMINDERS_ENABLED=false
ONBOARDING_IDEMPOTENCY_ACTIVE_KEY_VERSION=v1

# Assets
ASSET_CARD_KEK=
ASSET_IDEMPOTENCY_HMAC_ACTIVE_VERSION=v1
ASSET_IDEMPOTENCY_HMAC_KEYS_JSON=

# HR operations
HR_OPERATIONS_IDEMPOTENCY_HMAC_ACTIVE_VERSION=v1
HR_OPERATIONS_IDEMPOTENCY_HMAC_KEYS_JSON=

# Finance and payroll
FINANCE_IDEMPOTENCY_HMAC_ACTIVE_VERSION=v1
FINANCE_IDEMPOTENCY_HMAC_KEYS_JSON=
FINANCE_BANK_REFERENCE_ENC_ACTIVE_VERSION=v1
FINANCE_BANK_REFERENCE_ENC_KEYS_JSON=
PAYROLL_IDEMPOTENCY_HMAC_ACTIVE_VERSION=v1
PAYROLL_IDEMPOTENCY_HMAC_KEYS_JSON=
