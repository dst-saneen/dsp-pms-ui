  company    Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department Department?           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employee   Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project    Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([eventId, targetType, companyId, branchId, departmentId, employeeId, projectId])
  @@index([eventId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([projectId])
  @@map("business_calendar_event_targets")
}

model BusinessCalendarAmendment {
  id String @id @default(uuid())

  calendarId          String
  previousVersionId   String
  amendmentVersionId  String
  effectiveDate       DateTime @db.Date
  reason              String
  previousChecksum    String
  newChecksum         String
  impactSummary       Json
  createdByUserId     String
  publishedByUserId   String
  publishedAt         DateTime

  calendar          BusinessCalendar        @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  previousVersion   BusinessCalendarVersion @relation("BusinessCalendarAmendmentPreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  amendmentVersion  BusinessCalendarVersion @relation("BusinessCalendarAmendmentVersion", fields: [amendmentVersionId], references: [id], onDelete: Restrict)
  createdByUser     User                    @relation("BusinessCalendarAmendmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedByUser   User                    @relation("BusinessCalendarAmendmentPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  impacts BusinessCalendarImpact[]

  createdAt DateTime @default(now())

  @@unique([amendmentVersionId])
  @@index([calendarId, effectiveDate])
  @@index([previousVersionId])
  @@index([createdByUserId])
  @@index([publishedByUserId])
  @@map("business_calendar_amendments")
