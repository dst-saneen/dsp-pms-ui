model BusinessCalendarEvent {
  id String @id @default(uuid())

  calendarVersionId String
  companyId         String
  eventTypeId       String
  eventCategoryId   String
  eventSourceId     String

  eventCode   String?
  eventName   String
  description String?

  allDay              Boolean
  startDate           DateTime          @db.Date
  endDate             DateTime          @db.Date
  startsAt            DateTime?
  endsAt              DateTime?
  eventTimezone       String?
  businessDayEffect   BusinessDayEffect @default(NONE)
  paidHoliday         Boolean           @default(false)
  isOptionalHoliday   Boolean           @default(false)
  isProtected         Boolean           @default(false)
  externalReference   String?
  sourcePayloadHash   String?
  legacyHolidayId     String?           @unique

  createdByUserId String

  calendarVersion BusinessCalendarVersion       @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)
  company         Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  eventType       BusinessCalendarEventType     @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  eventCategory   BusinessCalendarEventCategory @relation(fields: [eventCategoryId], references: [id], onDelete: Restrict)
  eventSource     BusinessCalendarEventSource   @relation(fields: [eventSourceId], references: [id], onDelete: Restrict)
  createdByUser   User                          @relation("BusinessCalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  targets                BusinessCalendarEventTarget[]
  controllingRuntimeDays BusinessCalendarRuntimeDay[]
  candidateImportRows    BusinessCalendarImportRow[]
  optionalHolidayLeaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calendarVersionId, startDate, endDate])
  @@index([companyId, startDate, endDate])
  @@index([companyId, isOptionalHoliday, startDate])
  @@index([eventTypeId])
  @@index([eventCategoryId])
  @@index([eventSourceId])
  @@index([externalReference])
  @@index([createdByUserId])
  @@map("business_calendar_events")
}

model BusinessCalendarEventTarget {
  id String @id @default(uuid())

  eventId String

  targetType   CalendarEventTargetType
  companyId    String
  branchId     String?
  departmentId String?
  employeeId   String?
  projectId    String?

