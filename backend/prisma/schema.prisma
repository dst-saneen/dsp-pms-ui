  updatedAt DateTime @updatedAt

  @@unique([jobApplicationId, versionNo])
  @@unique([companyId, branchId, id])
  @@index([jobApplicationId, status])
  @@index([status])
  @@index([responseTokenHash])
  @@index([signatureResubmissionTokenHash])
  @@map("job_offers")
