model BusinessCalendar {
  id String @id @default(uuid())

  companyId        String
  branchId         String?
  parentCalendarId String?

  scope           BusinessCalendarScope
  scopeKey        String                      @unique
  calendarCode    String
  calendarName    String
  defaultTimezone String
  runtimeMode     BusinessCalendarRuntimeMode @default(LEGACY)
  isActive        Boolean                     @default(true)

  createdByUserId String
  updatedByUserId String

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parentCalendar BusinessCalendar? @relation("BusinessCalendarParent", fields: [parentCalendarId], references: [id], onDelete: Restrict)
  childCalendars BusinessCalendar[] @relation("BusinessCalendarParent")

  createdByUser User @relation("BusinessCalendarCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User @relation("BusinessCalendarUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  versions      BusinessCalendarVersion[]
  amendments    BusinessCalendarAmendment[]
  runtimeDays   BusinessCalendarRuntimeDay[]
  importBatches BusinessCalendarImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, calendarCode])
  @@index([companyId])
  @@index([branchId])
  @@index([parentCalendarId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("business_calendars")
}

model BusinessCalendarVersion {
  id String @id @default(uuid())

  calendarId String

  versionNumber     Int
  status            BusinessCalendarVersionStatus @default(DRAFT)
  effectiveFrom     DateTime                      @db.Date
  effectiveTo       DateTime?                     @db.Date
  amendsVersionId   String?
  changeReason      String?
  optimisticVersion Int                           @default(1)
  contentChecksum   String

  createdByUserId   String
  submittedByUserId String?
  submittedAt       DateTime?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  publishedByUserId String?
  publishedAt       DateTime?
  supersededAt      DateTime?

  calendar       BusinessCalendar         @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  amendsVersion  BusinessCalendarVersion? @relation("BusinessCalendarVersionAmends", fields: [amendsVersionId], references: [id], onDelete: Restrict)
  amendedByVersions BusinessCalendarVersion[] @relation("BusinessCalendarVersionAmends")

  createdByUser   User  @relation("BusinessCalendarVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedByUser User? @relation("BusinessCalendarVersionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser  User? @relation("BusinessCalendarVersionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  publishedByUser User? @relation("BusinessCalendarVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  workingWeekRules BusinessCalendarWorkingWeekRule[]
  events           BusinessCalendarEvent[]

  previousAmendments  BusinessCalendarAmendment[] @relation("BusinessCalendarAmendmentPreviousVersion")
  amendmentRecords    BusinessCalendarAmendment[] @relation("BusinessCalendarAmendmentVersion")

  companyRuntimeDays BusinessCalendarRuntimeDay[] @relation("BusinessCalendarRuntimeCompanyVersion")
  branchRuntimeDays  BusinessCalendarRuntimeDay[] @relation("BusinessCalendarRuntimeBranchVersion")

  importBatches BusinessCalendarImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([calendarId, versionNumber])
  @@index([calendarId, status, effectiveFrom])
  @@index([amendsVersionId])
  @@index([createdByUserId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@index([publishedByUserId])
  @@map("business_calendar_versions")
}

model BusinessCalendarWorkingWeekRule {
  id String @id @default(uuid())

  calendarVersionId String

  dayOfWeek    Int
  ruleMode     BusinessCalendarRuleMode
  isWorkingDay Boolean
  dayPortion   DayPortion               @default(FULL_DAY)
  reason       String?

