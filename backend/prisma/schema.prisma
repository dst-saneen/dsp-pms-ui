  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)

  versionNo Int
  status    JobOfferStatus @default(DRAFT)
  version   Int            @default(1)

  companyId    String
  branchId     String
  departmentId String
  designationId String

  reportingManagerEmployeeId String
  reportingManager           Employee @relation("JobOfferReportingManager", fields: [reportingManagerEmployeeId], references: [id], onDelete: Restrict)

  employmentType String?
