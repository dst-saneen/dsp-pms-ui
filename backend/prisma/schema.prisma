model EmployeeSeparation {
  id String @id @default(uuid())

  companyId String
  branchId  String
  version   Int @default(1)

  employeeId String

  separationType String
  // RESIGNATION
  // TERMINATION
  // RETIREMENT

  status String @default("PENDING_APPROVAL")
  // PENDING_APPROVAL
  // APPROVED
  // REJECTED
  // CLEARANCE_IN_PROGRESS
  // CANCELLED
  // COMPLETED

  resignationDate DateTime?
  lastWorkingDate DateTime?

  reason String?

  approvalTransactionId String?

  createdByUserId String?
  approvedByUserId String?
  approvedAt DateTime?
  rejectedByUserId String?
  rejectedAt DateTime?
  cancelledByUserId String?
  cancelledAt DateTime?
  cancellationReason String?

  // Legacy actor fields are historical only. New commands derive the acting
  // User from authentication and write the User snapshot columns above.
  approvedById String?

  completedById String?
  completedByUserId String?

  completedDate DateTime?

  clearanceRemarks String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser User? @relation("EmployeeSeparationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedByUser User? @relation("EmployeeSeparationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rejectedByUser User? @relation("EmployeeSeparationRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User? @relation("EmployeeSeparationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedByUser User? @relation("EmployeeSeparationCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clearance EmployeeClearance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, branchId, status])
  @@index([employeeId])
  @@index([status])
  @@unique([companyId, id])
  @@map("employee_separations")
}

