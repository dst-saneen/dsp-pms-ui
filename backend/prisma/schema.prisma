  @@index([officeScopeKey, businessDate, isCurrent])
  @@index([companyId, businessDate])
  @@index([branchId, businessDate])
  @@index([calendarId, businessDate])
  @@index([companyVersionId])
  @@index([branchVersionId])
  @@index([controllingEventId])
  @@map("business_calendar_runtime_days")
}

model BusinessCalendarImpact {
