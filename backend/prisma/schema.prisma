  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([calendarVersionId, dayOfWeek])
  @@index([calendarVersionId])
  @@map("business_calendar_working_week_rules")
}

model BusinessCalendarEventType {
