//
// ============================================
// MODELS
// ============================================
//

model CompanyGroup {
  id        String @id @default(uuid())
  groupCode String @unique
  groupName String

  description String?

  isActive Boolean @default(true)

  companies           Company[]
  userRoleAssignments UserRoleAssignment[]
  defaultUsers        User[]                  @relation("UserDefaultCompanyGroup")
  activeSessions      AuthSession[]           @relation("SessionActiveCompanyGroup")
  onboarding          OrganizationOnboarding?
  roles               Role[]
  userInvitations     UserInvitation[]
  userNotifications   UserNotification[]
  outboxEvents        OutboxEvent[]
  deliveryMessages    DeliveryMessage[]
  candidates          Candidate[]
  jobOpenings         JobOpening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_groups")
}

model Company {
  id String @id @default(uuid())

  companyGroupId String?

  companyCode String @unique
  companyName String

  registrationNo String?
  taxNumber      String?
  legalCountryCode String? @db.VarChar(2) @map("legal_country_code")

  parentCompanyId String?

  isActive Boolean @default(true)

  companyGroup CompanyGroup? @relation(fields: [companyGroupId], references: [id])

  parentCompany  Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies Company[] @relation("CompanyHierarchy")
  deliveryMessages        DeliveryMessage[]
  emailSuppressions       EmailSuppression[]
  deliveryCommandReceipts DeliveryCommandReceipt[]
  recruitmentCommandReceipts RecruitmentCommandReceipt[]
  hrCommandReceipts          HrCommandReceipt[]

  branches          Branch[]
  approvalWorkflows ApprovalWorkflow[]

  departments        Department[]
  hrRequestTemplates HrRequestTemplate[]
  hrRequestTypes     HrRequestType[]
  designations       Designation[]

  employees           Employee[]
  employeeAssignments EmployeeCompanyAssignment[]
  documentTemplates   DocumentTemplate[]
  documentCategories  EmployeeDocumentCategory[]
  documentTypes       EmployeeDocumentType[]
  projects            Project[]
  projectActionEvents ProjectActionEvent[]
  projectCommandReceipts ProjectCommandReceipt[]
  projectDocuments    ProjectDocument[]
  projectWorkLogs     WorkLogHeader[]
  projectDailyTimeTotals ProjectDailyTimeTotal[]
  workCategories      WorkCategory[]
  taskTypes           TaskType[]
  companySettings     CompanySetting[]
  holidays            Holiday[]
  leaveTypes            LeaveType[]
  leavePolicies         LeavePolicy[]
  companyHolidayPolicies CompanyHolidayPolicy[]
  resourceTypes         ResourceType[]
  resources             Resource[]
  employeeResources     EmployeeResource[]
  shifts                Shift[]

  assetCategories AssetCategory[]
  assetTypes      AssetType[]
  assets          Asset[]

  onboardingTemplates OnboardingTemplate[]
  employeeOnboardings EmployeeOnboarding[]

  salaryComponents    SalaryComponent[]
  employeeSalaries    EmployeeSalary[]
  employeeTaxProfiles EmployeeTaxProfile[]
  employeeDeductions  EmployeeDeduction[]
  payrollRuns         PayrollRun[]
  userRoleAssignments UserRoleAssignment[]
  defaultUsers        User[]               @relation("UserDefaultCompany")
  activeSessions      AuthSession[]        @relation("SessionActiveCompany")

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  onboardingTemplateScopes OnboardingTemplateScope[]

  shiftRosters              ShiftRoster[]
  shiftRosterEntries        ShiftRosterEntry[]
  shiftRosterOverrides      ShiftRosterOverride[]
  attendancePolicies        AttendancePolicy[]
  attendanceExceptions      AttendanceException[]
  attendanceRegularizations AttendanceRegularization[]
  attendancePeriods         AttendancePeriod[]
  leaveBalanceTransactions  LeaveBalanceTransaction[]
  overtimePolicies          OvertimePolicy[]
  overtimeRequests          OvertimeRequest[]
  compOffCredits            CompOffCredit[]
  compOffAllocations        CompOffAllocation[]
  userNotifications         UserNotification[]
  outboxEvents              OutboxEvent[]

  businessCalendars               BusinessCalendar[]
  businessCalendarEventTypes      BusinessCalendarEventType[]
  businessCalendarEventCategories BusinessCalendarEventCategory[]
  businessCalendarEventSources    BusinessCalendarEventSource[]
  businessCalendarEvents          BusinessCalendarEvent[]
  businessCalendarEventTargets    BusinessCalendarEventTarget[]
  businessCalendarRuntimeDays     BusinessCalendarRuntimeDay[]
  businessCalendarImpacts         BusinessCalendarImpact[]
  businessCalendarImportBatches   BusinessCalendarImportBatch[]
  jobOpenings                     JobOpening[]

  fileObjects          FileObject[]
  fileUploadSessions   FileUploadSession[]
  fileRetentionPolicies FileRetentionPolicy[]
  fileCommandReceipts  FileCommandReceipt[]
  recruitmentEmployeeDocumentMappings RecruitmentEmployeeDocumentMapping[]

  financialProfile       CompanyFinancialProfile?
  businessParties        BusinessParty[]
  financeCategories      FinanceCategory[]
  financePaymentAccounts FinancePaymentAccount[]
  financePeriods         FinancePeriod[]
  financeTransactions    FinanceTransaction[]
  financeCommandReceipts FinanceCommandReceipt[]
  financeActionEvents    FinanceActionEvent[]
  payrollCommandReceipts PayrollCommandReceipt[]
  payrollActionEvents    PayrollActionEvent[]
  payrollPayslips         PayrollPayslip[]
  payrollAdjustments      PayrollRunAdjustment[]
  payrollRunAttendancePeriods PayrollRunAttendancePeriod[]
  payrollRunEmployeeLines     PayrollRunEmployeeLine[]
  payrollRunEmployees         PayrollRunEmployee[]
  financeTransactionAttachments FinanceTransactionAttachment[]
  employeeSalaryLines         EmployeeSalaryLine[]
  generatedFileIntents        GeneratedFileIntent[]
  leaveRequests               LeaveRequest[]
  hrRequests                  HrRequest[]
  employeeSeparations         EmployeeSeparation[]
  employeeClearances          EmployeeClearance[]
  employeeClearanceItems      EmployeeClearanceItem[]
  moduleEntitlements          CompanyModuleEntitlement[]

  @@index([companyGroupId])
  @@index([parentCompanyId])
  @@map("companies")
}

/// Company-level module availability. A missing row is deliberately denied;
/// migrations and the Company insert trigger provision the canonical defaults.
model CompanyModuleEntitlement {
  id String @id @default(uuid())

  companyId String
  module    CompanyModuleCode
  isEnabled Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, module])
  @@index([companyId, isEnabled])
  @@index([module, isEnabled])
  @@map("company_module_entitlements")
}

model Branch {
  id String @id @default(uuid())

  companyId String

  branchCode String
  branchName String

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  countryCode  String?
  timezone     String?
  countrySubdivisionCode String?

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])

  departments         Department[]
  employees           Employee[]
  projects            Project[]
  projectWorkLogs     WorkLogHeader[]
  holidays            Holiday[]
  leavePolicies       LeavePolicy[]
  workingDays         BranchWorkingDay[]
  assets              Asset[]
  employeeAssetsAtAssignment EmployeeAsset[] @relation("EmployeeAssetBranchAtAssignment")
  userRoleAssignments UserRoleAssignment[]
  defaultUsers        User[]               @relation("UserDefaultBranch")
  activeSessions      AuthSession[]        @relation("SessionActiveBranch")
  deliveryMessages    DeliveryMessage[]

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  workingCalendarReviewedAt DateTime?
  onboardingTemplateScopes OnboardingTemplateScope[]

  shiftRosters              ShiftRoster[]
  shiftRosterEntries        ShiftRosterEntry[]
  shiftRosterOverrides      ShiftRosterOverride[]
  attendancePolicies        AttendancePolicy[]
  attendanceExceptions      AttendanceException[]
  attendanceRegularizations AttendanceRegularization[]
  attendancePeriods         AttendancePeriod[]
  leaveBalanceTransactions  LeaveBalanceTransaction[]
  overtimePolicies          OvertimePolicy[]
  overtimeRequests          OvertimeRequest[]
  compOffCredits            CompOffCredit[]
  compOffAllocations        CompOffAllocation[]
  userNotifications         UserNotification[]
  outboxEvents              OutboxEvent[]

  businessCalendars           BusinessCalendar[]
  businessCalendarRuntimeDays BusinessCalendarRuntimeDay[]
  businessCalendarImpacts     BusinessCalendarImpact[]
  businessCalendarEventTargets BusinessCalendarEventTarget[]
  jobOpenings                  JobOpening[]
  designationOnboardingAssignments DesignationOnboardingAssignment[]

  fileObjects        FileObject[]
  fileUploadSessions FileUploadSession[]

  financePaymentAccounts      FinancePaymentAccount[]
  financeTransactions         FinanceTransaction[]
  payrollRunAttendancePeriods PayrollRunAttendancePeriod[]
  payrollRunEmployees         PayrollRunEmployee[]
  hrRequests                  HrRequest[]
  employeeSeparations         EmployeeSeparation[]
  employeeClearances          EmployeeClearance[]
  employeeClearanceItems      EmployeeClearanceItem[]

  @@unique([companyId, branchCode])
  @@unique([companyId, id])
  @@map("branches")
}

model BranchWorkingDay {
  id String @id @default(uuid())

  branchId  String
  dayOfWeek Int
  isWorkingDay Boolean @default(true)
  dayPortion DayPortion @default(FULL_DAY)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
  @@map("branch_working_days")
}

model Department {
  id String @id @default(uuid())

  companyId String
  branchId  String

  departmentCode String
  departmentName String

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  employees     Employee[]
  leavePolicies LeavePolicy[]

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
