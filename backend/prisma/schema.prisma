  runtimeRevision Int
  isCurrent       Boolean  @default(true)

  companyVersionId String
  branchVersionId  String?

  timezone            String
  dayStatus           BusinessDayStatus
  dayPortion          DayPortion
  reasonCode          String
  reasonText          String
  controllingEventId  String?
  resolutionTrace     Json
  sourceChecksum      String
  resolvedAt          DateTime
  supersededAt        DateTime?

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch?                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  calendar        BusinessCalendar        @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  companyVersion  BusinessCalendarVersion @relation("BusinessCalendarRuntimeCompanyVersion", fields: [companyVersionId], references: [id], onDelete: Restrict)
  branchVersion   BusinessCalendarVersion? @relation("BusinessCalendarRuntimeBranchVersion", fields: [branchVersionId], references: [id], onDelete: Restrict)
  controllingEvent BusinessCalendarEvent? @relation(fields: [controllingEventId], references: [id], onDelete: Restrict)

  shiftRosterEntries       ShiftRosterEntry[]
