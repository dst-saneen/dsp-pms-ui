model FileObject {
  id      String @id @default(uuid())
  version Int    @default(0)

  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  storageProfileCode String

  objectKey             String
  providerObjectRef     String?

  status FileObjectStatus @default(QUARANTINED)

  originalFileNameEncrypted String
  fileNameEncNonce          String?
  fileNameEncTag            String?
  fileNameEncKeyVersion     String
  safeExtension             String

  declaredMimeType  String
  detectedMimeType  String?

  expectedSizeBytes Int
  actualSizeBytes   Int?

  expectedChecksumSha256 String
  actualChecksumSha256   String?

  clamAvEngineVersion    String?
  clamAvSignatureVersion String?
  clamAvResult           String?
  scannedAt              DateTime?

  sseMode     String?
  sseKeyRef   String?

  retentionClass FileRetentionClass?
  retainUntil    DateTime?

  legalHoldActorId  String?
  legalHoldAt       DateTime?
  legalHoldReason   String?

  deletionRequestActorId  String?
  deletionRequestedAt     DateTime?
  deletionRequestReason   String?
  deletionCompletedAt     DateTime?

  creatorUserId       String?
  creatorUser         User?   @relation("FileObjectCreator", fields: [creatorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  publicUploadContext String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadSessions       FileUploadSession[]
  operationAttempts    FileOperationAttempt[]
  accessAudits         FileAccessAudit[]
  recruitmentDocuments RecruitmentDocument[]  @relation("RecruitmentFileObject")
  employeeDocuments    EmployeeDocument[]     @relation("EmployeeFileObject")
  hrRequests           HrRequest[]
  projectDocuments     ProjectDocument[]
  offerSubmissions     OfferSignatureSubmission[]
  financeAttachments   FinanceTransactionAttachment[]
  payrollPayslip       PayrollPayslip?

  @@unique([companyId, id])
  @@unique([companyId, branchId, id])
  @@unique([storageProfileCode, objectKey])
  @@index([status, updatedAt])
  @@index([companyId, branchId, status, createdAt])
  @@index([retainUntil, status])
  @@index([actualChecksumSha256])
  @@map("file_objects")
}

model FileUploadSession {
  id      String @id @default(uuid())
  version Int    @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  purpose FileUploadPurpose

  jobOpeningId     String?
  jobApplicationId String?
  employeeId       String?
  jobOfferId       String?
  projectId        String?
  taskId           String?

  applicationOperationId String?

  expectedFileName    String
  safeExtension       String
  declaredMimeType    String
  expectedSizeBytes   Int
  expectedChecksumSha256 String

  quarantineObjectKey String

  publicSessionTokenHash String?
  requestDigest          String?
  creatorUserId          String?
  creatorUser            User? @relation("FileUploadSessionCreator", fields: [creatorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  status    FileUploadSessionStatus @default(ISSUED)
  expiresAt DateTime
  uploadedAt  DateTime?
  finalizedAt DateTime?

  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  operationId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, operationId])
  @@index([status, expiresAt])
  @@index([companyId, branchId, status, createdAt])
  @@index([jobOpeningId, applicationOperationId])
  @@index([jobOfferId, status])
  @@index([creatorUserId, status])
  @@index([companyId, projectId, taskId, status])
  @@map("file_upload_sessions")
}

model FileOperationAttempt {
  id String @id @default(uuid())

  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  uploadSessionId String?

  operationType FileOperationType
  attemptNo     Int               @default(1)

  status FileOperationStatus @default(PENDING)

  safeErrorClass String?
  safeErrorCode  String?

  workerCorrelationId String?

  startedAt      DateTime?
  completedAt    DateTime?
  nextAttemptAt  DateTime?
  leaseExpiresAt DateTime?

  createdAt DateTime @default(now())

  @@unique([fileObjectId, operationType, attemptNo])
  @@index([status, nextAttemptAt])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@map("file_operation_attempts")
}

/// Durable intent for system-generated private files (e.g. payslips) before object upload finalizes.
model GeneratedFileIntent {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  objectKey String
  purpose   String
  /// PENDING_UPLOAD | UPLOADED | FINALIZED | DELETE_PENDING | COMPENSATED | DEAD_LETTER
  status String

  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([status, updatedAt, companyId])
  @@index([companyId, correlationId])
  @@index([objectKey])
}

model FileAccessAudit {
  id String @id @default(uuid())

  fileObjectId   String
  fileObject     FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)
  documentType   String?
  documentId     String?

  companyId String
  branchId  String?

  actorUserId     String?
  actorEmployeeId String?
  publicOfferContext String?

  accessPurpose String
  decision      String

  denialCode String?

  requestId     String?
  correlationId String?

  accessedAt DateTime @default(now())

  @@index([fileObjectId, accessedAt])
  @@index([companyId, branchId, accessedAt])
  @@map("file_access_audits")
}

model FileRetentionPolicy {
  id String @id @default(uuid())

  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  retentionClass FileRetentionClass

  retentionRule  String
  retentionValue Int

  enabled  Boolean @default(false)
  version  Int     @default(0)

  approvedByUserId String?
  approvedAt       DateTime?

  lastUpdatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, retentionClass])
  @@map("file_retention_policies")
}

model OfferSignatureSubmission {
  id        String @id @default(uuid())
  companyId String
  branchId  String?

  jobOfferId       String
  jobOffer         JobOffer       @relation(fields: [jobOfferId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  submissionNo Int @default(1)

  recruitmentDocumentId String
  recruitmentDocument   RecruitmentDocument @relation(fields: [recruitmentDocumentId], references: [id], onDelete: Restrict)

  fileObjectId String
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  candidateLegalName        String
  declarationAcceptedAt     DateTime

  status  OfferSignatureSubmissionStatus @default(PENDING_VERIFICATION)
  version Int                            @default(0)

  submittedAt DateTime @default(now())

  verifiedByUserId String?
  verifiedAt       DateTime?
  verificationNote String?

  rejectedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?

  supersededBySubmissionId String?

  requestId     String?
  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobOfferId, submissionNo])
  @@index([jobOfferId, status])
  @@index([jobApplicationId, status])
  @@map("offer_signature_submissions")
}

model FileCommandReceipt {
  id String @id @default(uuid())

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operationId String

  commandType               String
  actorUserId               String?
  publicContext             String?
  canonicalHashFormatVersion String @default("v1")
  hmacKeyVersion            String?
  requestDigest             String
  responseSnapshot          Json

  createdAt DateTime @default(now())

  @@unique([companyId, operationId])
  @@index([companyId, commandType, createdAt])
  @@map("file_command_receipts")
}

model RecruitmentEmployeeDocumentMapping {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  mappingKind FileDocumentMappingKind

  employeeDocumentTypeId String
  employeeDocumentType   EmployeeDocumentType @relation(fields: [employeeDocumentTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, mappingKind])
  @@index([employeeDocumentTypeId])
  @@map("recruitment_employee_document_mappings")
}
