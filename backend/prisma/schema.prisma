model DeliveryMessage {
  id String @id @default(uuid())

  companyGroupId String?
  companyId      String?
  branchId       String?

  version Int @default(1)

  outboxEventId   String?
  outboxEventType String
  aggregateType   String?
  aggregateId     String?
  eventType       String?

  dedupeKey String @unique

  recipientKind DeliveryRecipientKind
  recipientId   String
  recipientUserId     String?
  recipientEmployeeId String?

  channel  DeliveryChannel
  provider DeliveryProvider @default(NONE)

  status       DeliveryMessageStatus @default(QUEUED)
  attemptCount Int                   @default(0)

  queuedAt      DateTime @default(now())
  nextAttemptAt  DateTime  @default(now())
  firstAttemptAt DateTime?
  lastAttemptAt  DateTime?
  acceptedAt     DateTime?
  deliveredAt    DateTime?
  terminalAt     DateTime?
  deadLetteredAt DateTime?
  lockedBy       String?
  lockedAt       DateTime?
  lockExpiresAt  DateTime?

  toAddress      String?
  toDisplayName  String?
  subject        String?
  templateKey                    String?
  templateVersion                String?
  recipientAddressCiphertext     String?
  recipientAddressNonce          String?
  recipientAddressAuthTag        String?
  recipientAddressKeyVersion     String?
  recipientAddressHmac           String?
  recipientAddressHmacKeyVersion String?
  subjectCiphertext              String?
  bodyTextCiphertext             String?
  bodyHtmlCiphertext             String?
  contentNonce                   String?
  contentAuthTag                 String?
  contentKeyVersion              String?

  clientReference   String?
  providerMessageId String?
  providerRequestId     String?
  providerEmailReference String?

  lastErrorCode String?
  lastErrorClass String?
  bypassReason  String?

  companyGroup      CompanyGroup? @relation(fields: [companyGroupId], references: [id], onDelete: Restrict)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch            Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outboxEvent       OutboxEvent?  @relation("OutboxEventToDeliveryMessages", fields: [outboxEventId], references: [id], onDelete: Restrict)
  recipientUser     User?         @relation("DeliveryRecipientUser", fields: [recipientUserId], references: [id], onDelete: Restrict)
  recipientEmployee Employee?     @relation("DeliveryRecipientEmployee", fields: [recipientEmployeeId], references: [id], onDelete: Restrict)
  attempts       DeliveryAttempt[]
  providerEvents DeliveryProviderEvent[]
  sourceSuppressions EmailSuppression[] @relation("DeliveryMessageSourceSuppression")
  commandReceipts    DeliveryCommandReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, channel, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([status, lockExpiresAt])
  @@index([companyId, branchId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([eventType, status, createdAt])
  @@index([outboxEventId])
  @@index([clientReference])
  @@unique([clientReference])
  @@index([providerEmailReference])
  @@index([recipientId, channel, status])
  @@map("delivery_messages")
}

model DeliveryAttempt {
  id                String @id @default(uuid())
  deliveryMessageId String

  provider  DeliveryProvider @default(NONE)
  attemptNo Int
  outcome   DeliveryAttemptOutcome

  providerRequestId  String?
  providerEmailReference String?
  clientReference    String?
  providerStatusCode Int?
  errorClass         String?
  errorCode          String?
  workerCorrelationId String?

  startedAt   DateTime @default(now())
  completedAt DateTime?
  attemptedAt DateTime @default(now())
  durationMs  Int?

  deliveryMessage DeliveryMessage @relation(fields: [deliveryMessageId], references: [id], onDelete: Restrict)

  @@unique([deliveryMessageId, attemptNo])
  @@index([deliveryMessageId])
  @@map("delivery_attempts")
}

model DeliveryProviderEvent {
  id                String @id @default(uuid())
  deliveryMessageId String?

  provider        DeliveryProvider
  eventType       String
  normalizedEventType    String?
  clientReference String?
  providerEmailReference String?

  providerEventId            String?
  canonicalPayloadDigest     String?
  canonicalPayloadHashVersion String?
  signatureTimestamp         DateTime?
  signatureAlgorithm         String?
  encryptedPayload           String?
  payloadNonce               String?
  payloadAuthTag             String?
  payloadKeyVersion          String?
  rawPayload                 Json

  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  failedAt     DateTime?
  processingErrorCode String?

  deliveryMessage    DeliveryMessage?   @relation(fields: [deliveryMessageId], references: [id], onDelete: Restrict)
  sourceSuppressions EmailSuppression[] @relation("DeliveryProviderEventSourceSuppression")

  @@index([clientReference])
  @@index([deliveryMessageId])
  @@index([providerEmailReference])
  @@unique([provider, canonicalPayloadDigest])
  @@unique([provider, providerEventId])
  @@map("delivery_provider_events")
}

model EmailSuppression {
  id             String  @id @default(uuid())
  companyGroupId String?
  companyId      String?

  addressHmac           String
  addressHmacKeyVersion String?
  reason                String
  sourceEventId         String?
  sourceDeliveryMessageId String?
  sourceProviderEventId   String?

  suppressedAt        DateTime  @default(now())
  suppressedByUserId  String?
  releasedAt          DateTime?
  releasedBy          String?
  releasedByUserId    String?
  releaseReason       String?
  version             Int       @default(1)

  company               Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceDeliveryMessage DeliveryMessage?       @relation("DeliveryMessageSourceSuppression", fields: [sourceDeliveryMessageId], references: [id], onDelete: Restrict)
  sourceProviderEvent   DeliveryProviderEvent? @relation("DeliveryProviderEventSourceSuppression", fields: [sourceProviderEventId], references: [id], onDelete: Restrict)
  suppressedByUser      User?                  @relation("EmailSuppressionSuppressedBy", fields: [suppressedByUserId], references: [id], onDelete: Restrict)
  releasedByUser        User?                  @relation("EmailSuppressionReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)
  commandReceipts       DeliveryCommandReceipt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addressHmac, companyGroupId])
  @@index([addressHmac])
  @@index([companyId, addressHmac])
  @@map("email_suppressions")
}

model DeliveryCommandReceipt {
  id          String @id @default(uuid())
  operationId String @unique

  companyId                String?
