  @@index([taskId])
  @@index([workCategoryId])
  @@index([workDate])
  @@index([sourceType])
  @@index([taskWorkSessionId])
  @@index([companyId, employeeId, workDate])
  @@index([companyId, taskId])
  @@index([companyId, taskId, workDate])
