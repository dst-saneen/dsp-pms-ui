  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  companyGroup CompanyGroup? @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId, scopeKey])
  @@index([userId, isActive])
  @@index([roleId])
  @@index([companyGroupId])
  @@index([companyId])
  @@index([branchId])
  @@map("user_role_assignments")
}

model AuthSession {
  id String @id @default(uuid())

  userId           String
  refreshTokenHash String @unique
  securityVersion  Int

  activeCompanyGroupId String?
  activeCompanyId      String?
  activeBranchId       String?

  authorizationSnapshot Json
  lastActivityAt        DateTime  @default(now())
  idleExpiresAt         DateTime
  absoluteExpiresAt     DateTime
  revokedAt             DateTime?
  revocationReason      String?
  ipHash                String?
  userAgentHash         String?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyGroup CompanyGroup? @relation("SessionActiveCompanyGroup", fields: [activeCompanyGroupId], references: [id])
  activeCompany      Company?      @relation("SessionActiveCompany", fields: [activeCompanyId], references: [id])
  activeBranch       Branch?       @relation("SessionActiveBranch", fields: [activeBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([activeCompanyGroupId])
  @@index([activeCompanyId])
  @@index([activeBranchId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model SecurityEvent {
  id String @id @default(uuid())

  userId    String?
  type      SecurityEventType
  requestId String?
  sessionId String?
  ipHash    String?
  metadata  Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

model Designation {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  departmentId String?
  department   Department? @relation("DesignationHomeDepartment", fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  designationCode String
  designationName String

  level Int?

  isActive Boolean @default(true)

  employees     Employee[]
  leavePolicies LeavePolicy[]

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  onboardingTemplateScopes OnboardingTemplateScope[]
  onboardingTemplateTasks  OnboardingTemplateTask[]
  employeeOnboardingTasks  EmployeeOnboardingTask[] @relation("OnboardingTaskAssignedDesignation")
  onboardingTemplate       OnboardingTemplate?       @relation(fields: [onboardingTemplateId], references: [id])
  onboardingTemplateId     String?

  onboardingAssignments DesignationOnboardingAssignment[]
  jobOpenings           JobOpening[]

  @@unique([companyId, designationCode])
  @@index([companyId, departmentId])
  @@map("designations")
}

model HrRequest {
  id String @id @default(uuid())

  requestNo String

  companyId String
  branchId  String
  version   Int @default(1)

  employeeId String

  requestTypeId String

  status String @default("PENDING_APPROVAL")

  requestDate DateTime @default(now())

  remarks String?

  approvalTransactionId String? @unique

  fileObjectId String?

  createdByUserId String?
  approvedByUserId String?
  approvedAt DateTime?
  rejectedByUserId String?
  rejectedAt DateTime?
  completedByUserId String?
  completedAt DateTime?
  cancelledByUserId String?
  cancelledAt DateTime?
  cancellationReason String?

  // Historical local paths are readable only. New requests use File Storage
  // V2 through fileObjectId; this column must never be populated by runtime.
  generatedFilePath String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  requestType HrRequestType @relation(fields: [companyId, requestTypeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  approvalTransaction ApprovalTransaction? @relation("HrRequestApprovalTransaction", fields: [approvalTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fileObject FileObject? @relation(fields: [companyId, branchId, fileObjectId], references: [companyId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser User? @relation("HrRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedByUser User? @relation("HrRequestApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rejectedByUser User? @relation("HrRequestRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedByUser User? @relation("HrRequestCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledByUser User? @relation("HrRequestCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, branchId, status])
  @@index([employeeId, status])
  @@index([approvalTransactionId])
  @@index([fileObjectId])
  @@unique([companyId, requestNo])
  @@unique([companyId, id])
  @@map("hr_requests")
}

model HrCommandReceipt {
  id String @id @default(uuid())

  companyId String
  operationId String
  commandType String
  requestDigest String
  requestHmacKeyVersion String
  responseSnapshot Json
  actorUserId String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser User? @relation("HrCommandReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, operationId])
  @@index([companyId, commandType])
  @@map("hr_command_receipts")
}

model HrRequestTemplate {
  id String @id @default(uuid())

  companyId String

  requestTypeId String

  templateName String

  templateBody String

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])

  requestType HrRequestType @relation(fields: [requestTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hr_request_templates")
}

model HrRequestType {
  id String @id @default(uuid())

  companyId String

  requestCode String
  requestName String

  workflowId String?

  workflow ApprovalWorkflow? @relation(fields: [workflowId], references: [id])

  requiresApproval Boolean @default(true)

  autoGenerate Boolean @default(false)

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])

  templates HrRequestTemplate[]
  requests  HrRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, requestCode])
  @@unique([companyId, id])
  @@map("hr_request_types")
}

model ApprovalWorkflow {
  id String @id @default(uuid())

  workflowCode String
  workflowName String
  scopeKey     String @unique

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  isActive Boolean @default(true)

  steps ApprovalWorkflowStep[]

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  approvalTransactions          ApprovalTransaction[]
  requestTypes                  HrRequestType[]
  onboardingTemplateTasks       OnboardingTemplateTask[]
  onboardingDepartmentTemplates OnboardingDepartmentTemplate[]
  executionRules                ExecutionRule[]

  @@index([workflowCode])
  @@index([companyId, workflowCode, isActive])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id String @id @default(uuid())

  workflowId String

  stepNo Int

  approverType String
  approverRole String?

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  createdAt DateTime @default(now())

  @@unique([workflowId, stepNo])
  @@map("approval_workflow_steps")
}

model ApprovalTransaction {
  id String @id @default(uuid())

  workflowId String

  entityType String
  entityId   String

  requestedById String?
  leaveRequest  LeaveRequest?

  requestedBy Employee? @relation("TransactionRequester", fields: [requestedById], references: [id])

  currentStep Int @default(1)

  status String @default("PENDING")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  approvalSteps  ApprovalTransactionStep[]
  workLogHeaders WorkLogHeader[]
  hrRequest      HrRequest? @relation("HrRequestApprovalTransaction")

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  employeeOnboardingTasks EmployeeOnboardingTask[]

  attendanceRegularization AttendanceRegularization?
  overtimeRequest          OvertimeRequest?

  @@index([entityType, entityId])
  @@index([status])
  @@map("approval_transactions")
}

model ApprovalTransactionStep {
  id String @id @default(uuid())

  transactionId String

  stepNo Int

  approverId String?
  approver   Employee? @relation("ApprovalApprover", fields: [approverId], references: [id])

  status String  @default("PENDING")
  action String?

  remarks String?

  actionDate DateTime?

  transaction ApprovalTransaction @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([approverId])
  @@index([approverId, status, stepNo])
  @@map("approval_transaction_steps")
}

model DocumentTemplate {
  id String @id @default(uuid())

  companyId String?

  templateCode String
  templateName String

  templateContent String

  fileFormat String @default("PDF")

  isActive Boolean @default(true)

  company Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, templateCode])
  @@map("document_templates")
}

//
// ============================================
// PROJECT LITE (typed contract after Phase 3)
// ============================================
//

enum ProjectType {
  CLIENT
  INTERNAL
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectStageStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_REVIEW
  COMPLETED
  CANCELLED
}

enum ProjectTeamMemberStatus {
  ACTIVE
  ENDED
}

enum ProjectTaskParticipantStatus {
  ACTIVE
  ENDED
}

enum WorkLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  CANCELLED
}

enum ProjectActionEntityType {
  PROJECT
  STAGE
  TEAM_MEMBER
  TASK
  TASK_PARTICIPANT
  TASK_SUBMISSION
  WORK_LOG
  PROJECT_DOCUMENT
}

enum TaskSubmissionStatus {
  SUBMITTED
  RETURNED
  ACCEPTED
  CANCELLED
}

enum TaskReviewDecision {
  RETURN
  COMPLETE
  CANCEL
}

model Project {
  id      String @id @default(uuid())
  version Int    @default(1)

  projectCode String
  projectName String

  description String?

  /// Legacy client strings — historical read-only until BusinessParty mapping.
  clientName    String?
  clientContact String?

  businessPartyId String?
  businessParty   BusinessParty? @relation(fields: [companyId, businessPartyId], references: [companyId, id], onDelete: Restrict)

  startDate DateTime?
  endDate   DateTime?

  contractValue Decimal?
  currency      String?

  /// Legacy free-string status. Prefer statusV2 for V2 commands.
  status   String        @default("DRAFT")
  statusV2 ProjectStatus @default(DRAFT)

  projectType ProjectType @default(INTERNAL)

  currencyCode    String?
  expectedIncome  Decimal? @db.Decimal(18, 2)
  expenseBudget   Decimal? @db.Decimal(18, 2)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  projectManagerId String?  @map("projectmanagerId")
  projectManager   Employee? @relation("ProjectManager", fields: [companyId, projectManagerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  activatedAt         DateTime?
  activatedByUserId   String?
  heldAt              DateTime?
  heldByUserId        String?
  holdReason          String?
  resumedAt           DateTime?
  resumedByUserId     String?
  completedAt         DateTime?
  completedByUserId   String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancellationReason  String?
  archivedAt          DateTime?
  archivedByUserId    String?
  archiveReason       String?

  createdBy   String?
  updatedBy   String?
  teamMembers ProjectTeamMember[]
  stages      ProjectStage[]
  tasks       ProjectTask[]
  documents   ProjectDocument[]

  financeTransactions FinanceTransaction[]

  businessCalendarEventTargets BusinessCalendarEventTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, projectCode])
  @@index([companyId])
  @@index([companyId, businessPartyId])
  @@index([branchId])
  @@index([projectManagerId])
  @@index([companyId, projectManagerId])
  @@index([status])
  @@index([companyId, status])
  @@index([companyId, statusV2])
  @@index([companyId, branchId, statusV2])
  @@index([businessPartyId])
  @@map("projects")
}

model ProjectTeamMember {
  id      String @id @default(uuid())
  version Int    @default(1)

  companyId  String
  projectId  String
  employeeId String

  role String

  allocationPercentage Decimal @default(100)

  startDate DateTime?
  endDate   DateTime?

  assignedById String?

  isActive Boolean @default(true)

  allocationSource String?

  allocationStatus String @default("ACTIVE")
  statusV2         ProjectTeamMemberStatus @default(ACTIVE)

  remarks String?

  assignedByUserId String?
  assignedAt       DateTime?
  endedByUserId    String?
  endedAt          DateTime?
  endReason        String?

  project    Project   @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  employee   Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  assignedBy Employee? @relation("ProjectTeamMemberAssignedBy", fields: [assignedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([employeeId])
  @@index([companyId, projectId])
  @@index([companyId, employeeId])
  @@index([statusV2])
  @@index([employeeId, statusV2])
  @@map("project_team_members")
}

model ProjectTeamMemberHistory {
  id String @id @default(uuid())

  projectTeamMemberId String

  companyId  String?
  projectId  String
  employeeId String

  oldRole   String?
  newRole   String?
  changedBy Employee? @relation(fields: [employeeId], references: [id])

  oldAllocationPercentage Decimal?
  newAllocationPercentage Decimal?

  oldStartDate DateTime?
  newStartDate DateTime?

  oldEndDate DateTime?
  newEndDate DateTime?

  action String

  remarks String?

  changedById     String?
  actorUserId     String?
  operationId     String?
  protectedReason String?

  changedAt DateTime @default(now())

  @@index([projectTeamMemberId])
  @@index([projectId])
  @@index([employeeId])
  @@index([companyId, projectId])
  @@index([operationId])
  @@map("project_team_member_history")
}

model ProjectStage {
  id      String @id @default(uuid())
  version Int    @default(1)

  companyId String
  projectId String

  stageCode String
  stageName String

  description String?

  sequenceNo Int

  status   String             @default("OPEN")
  statusV2 ProjectStageStatus @default(PLANNED)

  startDate DateTime?
  endDate   DateTime?

  activatedAt        DateTime?
  activatedByUserId  String?
  completedAt        DateTime?
  completedByUserId  String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?

  project Project       @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  tasks   ProjectTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, stageCode])
  @@unique([projectId, sequenceNo])
  @@unique([companyId, id])
  @@unique([companyId, projectId, id])
  @@index([projectId])
  @@index([companyId, projectId])
  @@index([companyId, statusV2])
  @@map("project_stages")
}

model ProjectTask {
  id      String @id @default(uuid())
  version Int    @default(1)

  companyId String
  projectId String
  stageId   String

  taskCode String
  taskName String

  taskTypeId String?

  parentTaskId String?

  description String?

  priority String @default("MEDIUM")

  plannedHours         Decimal? @default(0)
  estimatedReviewHours Decimal? @default(0)
  completionPercentage Decimal? @default(0)

  startDate DateTime?
  dueDate   DateTime?

  status   String            @default("OPEN")
  statusV2 ProjectTaskStatus @default(OPEN)

  submittedForReviewAt       DateTime?
  submittedForReviewByUserId String?
  returnedAt                 DateTime?
  returnedByUserId           String?
  returnReason               String?
  completedAt                DateTime?
  completedByUserId          String?
  cancelledAt                DateTime?
  cancelledByUserId          String?
  cancellationReason         String?
  archivedAt                 DateTime?
  archivedByUserId           String?

  project           Project            @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  workScheduleItems WorkScheduleItem[]

  stage             ProjectStage            @relation(fields: [companyId, projectId, stageId], references: [companyId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  participants      TaskParticipant[]
  submissions       TaskSubmission[]
  assignmentHistory TaskAssignmentHistory[]
  documents         ProjectDocument[]
  taskType          TaskType?               @relation(fields: [taskTypeId], references: [id])

  parentTask   ProjectTask?  @relation("TaskHierarchy", fields: [companyId, projectId, parentTaskId], references: [companyId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  workLogLines WorkLogLine[]

  subTasks ProjectTask[] @relation("TaskHierarchy")

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, taskCode])
  @@unique([companyId, id])
  @@unique([companyId, projectId, id])
  @@index([projectId])
  @@index([stageId])
  @@index([status])
  @@index([parentTaskId])
  @@index([companyId, projectId, status])
  @@index([companyId, stageId])
  @@index([companyId, statusV2, dueDate])
  @@map("project_tasks")
}

model TaskType {
  id String @id @default(uuid())

  companyId String?

  taskTypeCode String
  taskTypeName String

  description String?

  defaultPlannedHours Decimal?

  estimatedComplexity String?

  isBillable Boolean @default(true)

  isActive Boolean @default(true)

  company Company? @relation(fields: [companyId], references: [id])

  tasks ProjectTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, taskTypeCode])
  @@map("task_types")
}

model TaskParticipant {
  id      String @id @default(uuid())
  version Int    @default(1)

  companyId String
  projectId String
  taskId    String

  employeeId String

  role String

  plannedHours Decimal? @default(0)

  actualHours Decimal? @default(0)

  status   String                       @default("PENDING")
  statusV2 ProjectTaskParticipantStatus @default(ACTIVE)

  assignedByUserId String?
  assignedAt       DateTime?
  endedByUserId    String?
  endedAt          DateTime?
  endReason        String?

  task ProjectTask @relation(fields: [companyId, projectId, taskId], references: [companyId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  employee Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Active-only uniqueness is enforced in DB:
  /// task_participants_one_active_assignment_idx WHERE statusV2 = 'ACTIVE'
  @@index([taskId])
  @@index([employeeId])
  @@index([companyId, projectId])
  @@index([companyId, employeeId, statusV2])
  @@index([employeeId, statusV2])
  @@map("task_participants")
}

model TaskSubmission {
  id      String @id @default(uuid())
  version Int    @default(1)

  companyId String
  projectId String
  taskId    String

  versionNo Int

  submissionNotes String?

  /// Legacy local path — historical only until File Storage import.
  filePath String?

  submittedById     String
  submittedByUserId String?

  status   String                @default("SUBMITTED")
  statusV2 TaskSubmissionStatus?

  submittedAt DateTime @default(now())

  task ProjectTask @relation(fields: [companyId, projectId, taskId], references: [companyId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  submittedBy Employee         @relation("TaskSubmissionEmployee", fields: [companyId, submittedById], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  reviews     TaskReview[]
  documents   ProjectDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, versionNo])
  @@unique([companyId, id])
  @@unique([companyId, projectId, taskId, id])
  @@index([taskId])
  @@index([companyId, projectId])
  @@map("task_submissions")
}

model TaskAssignmentHistory {
  id String @id @default(uuid())

  companyId String?
  projectId String?
  taskId    String

  employeeId String

  role String

  action String

  previousEmployeeId String?
  previousEmployee   Employee? @relation("TaskPreviousEmployee", fields: [previousEmployeeId], references: [id])

  remarks String?

  assignedById String?
  actorUserId  String?
  operationId  String?

  task ProjectTask @relation(fields: [taskId], references: [id])

  employee Employee @relation("TaskAssignmentEmployee", fields: [employeeId], references: [id])

  assignedBy Employee? @relation("TaskAssignedByEmployee", fields: [assignedById], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([employeeId])
  @@index([companyId, projectId])
  @@map("task_assignment_history")
}

model TaskReview {
  id      String @id @default(uuid())
  version Int    @default(1)

  companyId    String
  projectId    String
  taskId       String
  submissionId String

  reviewerId     String
  reviewerUserId String?

  decision   String
  decisionV2 TaskReviewDecision?

  comments String?

  reviewHours Decimal? @default(0)
  reviewRound Int      @default(1)

  reviewedAt DateTime @default(now())

  submission TaskSubmission @relation(fields: [companyId, projectId, taskId, submissionId], references: [companyId, projectId, taskId, id], onDelete: Restrict, onUpdate: Restrict)

  reviewer Employee @relation("TaskReviewer", fields: [companyId, reviewerId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([reviewerId])
  @@index([companyId, projectId])
  @@map("task_reviews")
}

model ProjectActionEvent {
  id String @id @default(uuid())

  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  entityType ProjectActionEntityType
  entityId   String
  projectId  String?

  fromState String?
  toState   String?

  actorUserId String
  actorUser   User   @relation("ProjectActionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  versionBefore Int?
  versionAfter  Int?

  operationId     String
  protectedReason String?
  protectedNote   String?

  createdAt DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, projectId, createdAt])
  @@index([companyId, operationId])
  @@map("project_action_events")
}

model ProjectCommandReceipt {
  id String @id @default(uuid())

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operationId String
  commandType String
  actorUserId String
  actorUser   User    @relation("ProjectCommandReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  requestHash              String
  requestHashKeyVersion    String
  requestHashFormatVersion Int    @default(1)

  resultEntityType   String?
  resultEntityId     String?
  safeResultSnapshot Json?
  completedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([companyId, operationId])
  @@index([companyId, commandType])
  @@index([resultEntityType, resultEntityId])
  @@map("project_command_receipts")
}

model ProjectDocument {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  projectId String
  project   Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  taskId String?
  task   ProjectTask? @relation(fields: [companyId, projectId, taskId], references: [companyId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  taskSubmissionId String?
