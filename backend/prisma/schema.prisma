  branchId       String?

  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  dedupeKey     String @unique

  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastErrorCode String?

  companyGroup CompanyGroup? @relation(fields: [companyGroupId], references: [id], onDelete: Restrict)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  deliveryMessages DeliveryMessage[] @relation("OutboxEventToDeliveryMessages")
  deliveryRecipientExceptions DeliveryRecipientException[] @relation("OutboxEventToRecipientExceptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([companyGroupId])
  @@index([companyId])
  @@index([branchId])
  @@map("outbox_events")
}

