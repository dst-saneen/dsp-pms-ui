# QA operator profile only. Do not load this file into the application runtime.
# Supply passwords and tokens through the local secret store or CI secrets.

# Every writer verifies these fields against DATABASE_URL before changing data.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/dsp_erp_dev
DATABASE_NAME=dsp_erp_dev
DATABASE_USER=dscape
DATABASE_SCHEMA=dsp_pms_stg

# Staging write interlocks. Never use dsp_pms here.
ALLOW_DESTRUCTIVE_DB_SCRIPTS=false
QA_STAGING_SENTINEL_KEY=DSP-ERP-QA-STAGING
QA_STAGING_CONFIRMATION_TOKEN=CONFIRM-QA-WRITES:dsp_erp_dev:dsp_pms_stg
QA_STAGING_SENTINEL_BOOTSTRAP_TOKEN=BOOTSTRAP-QA-SENTINEL:dsp_erp_dev:dsp_pms_stg

# Authenticated QA personas. Inject real values; do not commit them.
QA_REFERENCE_PERSONA_PASSWORD=
E2E_MAKER_EMAIL=
E2E_MAKER_PASSWORD=
E2E_APPROVER_EMAIL=
E2E_APPROVER_PASSWORD=
E2E_ALLOW_SKIP_PASSWORD_CHANGE=false

# Opt-in integration and concurrency controls.
OFFICE_FINANCE_PAYROLL_CONCURRENCY=0
CONCURRENCY_ALLOW_SHARED=0
ASSET_PG_TEST=false
PROJECTS_PG_CONCURRENCY_TESTS=false
RECRUITMENT_DELIVERY_PG_TEST=false

# Run-owned evidence locations.
QA_EVIDENCE_DIR=
QA_RUN_MANIFEST_DIR=
# Optional absolute path to pg_dump for structure evidence. When empty, the
# guarded QA tools use pg_dump available on PATH.
PG_DUMP_BIN=
