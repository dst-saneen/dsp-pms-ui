# Backend base URL used by the Next.js server-side proxy. It is never exposed
# to browsers.
BACKEND_INTERNAL_URL=http://localhost:4500

# Recruitment and delivery availability comes from backend capability APIs.
# Do not add NEXT_PUBLIC module or business rollout flags here.

# Recruitment mock APIs are opt-in for local development only. Omitted or false
# uses the live API; production builds always disable this switch.
NEXT_PUBLIC_RECRUITMENT_USE_MOCK=false

# Optional public Turnstile site key. It is required for production public
# applications and is intentionally browser-visible.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
