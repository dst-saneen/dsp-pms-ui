# Playwright-only inputs. Supply these through your test-runner environment;
# never commit real credentials.

# Optional browser base URL, backend API URL, and artifact directory.
# PLAYWRIGHT_BASE_URL=http://localhost:3200
# PLAYWRIGHT_API_URL=http://localhost:4500
# PLAYWRIGHT_OUTPUT_DIR=./test-results

# Authenticated test persona.
# E2E_MAKER_EMAIL=
# E2E_MAKER_PASSWORD=

# Permit tests that intentionally create or mutate live data.
PLAYWRIGHT_LIVE_MUTATIONS=false

# Use development-only local recruitment mock data.
PLAYWRIGHT_USE_MOCK=false
